{
  "name": "threshingdaygame",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node --import tsx scripts/prerender.tsx && node scripts/prepare-sites-build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "preview:cf": "wrangler dev --local --ip 127.0.0.1 --port 4175",
    "check:cf": "wrangler deploy --dry-run",
    "deploy:cf": "npm run build && wrangler deploy",
    "test:community": "wrangler deploy --dry-run --outdir dist/cf-test && node --test tests/community-worker.test.mjs",
    "db:local": "wrangler d1 migrations apply threshingday-community --local"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  }
}
